enum Tree {
    leaf,
    branch(Branch),
}

struct Branch {
    left: Tree,
    right: Tree,
}

fn default_n() -> I32 {
    if arg_count() > 1 { parse_i32(arg_text(1)) } else { 21 }
}

fn item_check(tree: Tree) -> I32 {
    match tree {
        Tree.leaf => { 1 },
        Tree.branch(node) => { 1 + item_check(node.left) + item_check(node.right) },
    }
}

fn bottom_up_tree(depth: I32) -> Tree effects [alloc] {
    if depth > 0 {
        Tree.branch(Branch { left: bottom_up_tree(depth - 1), right: bottom_up_tree(depth - 1) })
    } else {
        Tree.leaf
    }
}

fn pow2(n: I32) -> I32 {
    if n == 0 { 1 } else { 2 * pow2(n - 1) }
}

fn make_depth_line(builder: TextBuilder, prefix: Text, v: I32, check: I32) -> TextBuilder {
    let mut b = builder;
    b += prefix;
    b += v;
    b += "\t";
    b += " check: ";
    b += check;
    b += "\n";
    b
}

fn make_iter_depth_line(builder: TextBuilder, iter: I32, depth: I32, check: I32) -> TextBuilder {
    let mut b = builder;
    b += iter;
    b += "\t";
    b += " trees of depth ";
    b += depth;
    b += "\t";
    b += " check: ";
    b += check;
    b += "\n";
    b
}

fn main() -> Text effects [alloc, io] {
    let n = default_n();
    let min_depth = 4;
    let max_depth = if min_depth + 2 > n { min_depth + 2 } else { n };
    let stretch_depth = max_depth + 1;
    let stretch_tree = bottom_up_tree(stretch_depth);
    let mut builder = text_builder_new();
    builder = make_depth_line(builder, "stretch tree of depth ", stretch_depth, item_check(stretch_tree));
    let tree = bottom_up_tree(max_depth);
    let mut depth = min_depth;
    while depth <= max_depth {
        let d = max_depth - depth;
        let iter = pow2(d + min_depth);
        let mut check = 0;
        let mut i = 0;
        while i < iter {
            let t = bottom_up_tree(depth);
            check += item_check(t);
            i += 1;
        };
        builder = make_iter_depth_line(builder, iter, depth, check);
        depth += 2;
    };
    builder = make_depth_line(builder, "long lived tree of depth ", max_depth, item_check(tree));
    text_builder_finish(builder)
}