enum Tree {
    leaf,
    branch(Branch),
}

struct Branch {
    left: Tree,
    right: Tree,
}

fn default_n() -> I32 {
    if arg_count() > 1 {
        parse_i32(arg_text(1))
    } else {
        21
    }
}

fn item_check(tree: Tree) -> I32 {
    match tree {
        Tree.leaf => {
            1
        },
        Tree.branch(node) => {
            1 +
            item_check(node.left) +
            item_check(node.right)
        },
    }
}

fn bottom_up_tree(depth: I32) -> Tree effects [alloc] {
    if depth > 0 {
        Tree.branch(Branch { left: bottom_up_tree(depth - 1), right: bottom_up_tree(depth - 1) })
    } else {
        Tree.leaf
    }
}

fn append_line(builder: TextBuilder, prefix: Text, value: I32, extra: I32, suffix: Text) -> TextBuilder {
    let mut current = builder;
    current = current + prefix;
    current = current + value;
    current = current + "	 check: ";
    current = current + extra;
    current = current + suffix;
    current = current + "\n";
    current
}

fn append_depth_line(builder: TextBuilder, iterations: I32, depth: I32, check: I32) -> TextBuilder {
    let mut current = builder;
    current = current + iterations;
    current = current + "	 trees of depth ";
    current = current + depth;
    current = current + "	 check: ";
    current = current + check;
    current = current + "\n";
    current
}

fn main() -> Text effects [alloc] {
    let n = default_n();
    let min_depth = 4;
    let max_depth = if min_depth + 2 > n {
        min_depth + 2
    } else {
        n
    };
    let stretch_depth = max_depth + 1;
    let mut builder = text_builder_new();
    with_arena {
        let stretch_tree = bottom_up_tree(stretch_depth);
        builder = append_line(builder, "stretch tree of depth ", stretch_depth, item_check(stretch_tree), "");
    };
    let long_lived_tree = bottom_up_tree(max_depth);
    let mut depth = min_depth;
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + min_depth);
        let mut check = 0;
        let mut run = 0;
        while run < iterations {
            with_arena {
                let tree = bottom_up_tree(depth);
                check = check + item_check(tree);
            };
            run = run + 1;
        };
        builder = append_depth_line(builder, iterations, depth, check);
        depth = depth + 2;
    };
    builder = builder + "long lived tree of depth ";
    builder = builder + max_depth;
    builder = builder + "	 check: ";
    builder = builder + item_check(long_lived_tree);
    text_builder_finish(builder)
}
