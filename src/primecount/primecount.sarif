fn is_prime(n: I32) -> Bool {
    if n >= 2 {
        if n % 2 == 0 {
            n == 2
        } else {
            let mut i = 3;
            while n / i >= i and n % i != 0 {
                i += 2;
            };
            n / i < i
        }
    } else {
        false
    }
}

fn main() -> I32 {
    let n = if arg_count() > 1 {
        parse_i32(arg_text(1))
    } else {
        50000
    };
    let mut count = 0;
    let mut i = 2;
    while i <= n {
        if is_prime(i) {
            count += 1;
        };
        i += 1;
    };
    count
}
